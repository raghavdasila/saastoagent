# The two images use only application source and the pinned compatibility
# package. Keep preserved archives, credentials, local environments, and
# unrelated repository evidence out of Docker's build context.
*
!backend/
!backend/**
!frontend/
!frontend/**
!vendor/
!vendor/**
!.dockerignore

.venv/
venv/
frontend/node_modules/
frontend/dist/
frontend/dist_verify/
frontend/recordings/
frontend/test-results/
**/__pycache__/
**/.pytest_cache/
**/*.py[cod]
**/*.egg-info/
**/test-results/
