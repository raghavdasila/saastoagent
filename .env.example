# Reference for the ignored .env.local file. scripts/init-local.ps1 generates
# direct-host defaults and real local secrets; never copy or commit placeholders.
ROUTEDECK_DATABASE_URL=sqlite+pysqlite:///D:/absolute/path/to/saastoagent-v0.1/.runtime/routedeck.sqlite
ROUTEDECK_STATE_ENCRYPTION_KEY=<generated-fernet-key>
ROUTEDECK_INSTANCE_ID=corpus-local
ROUTEDECK_REVIEW_TTL_SECONDS=900
ROUTEDECK_RESUME_CAPABILITY_TTL_SECONDS=86400
ROUTEDECK_WORKER_COUNT=1
ROUTEDECK_BROWSER_ORIGINS=http://127.0.0.1:5199
CORPUS_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest
OPENAI_API_KEY=<openai-api-key-required-only-when-provider-is-openai>
CORPUS_OPENAI_MODEL=gpt-5.6-luna
CORPUS_OPENAI_REASONING_EFFORT=low
CORPUS_EVAL_PROVIDER=ollama
CORPUS_EVAL_TESTER_MODEL=gemma4:latest
CORPUS_EVAL_JUDGE_MODEL=gemma4:latest
CORPUS_SOURCE_DATA_ROOT=D:/absolute/path/to/saastoagent-v0.1/.runtime/sources
CORPUS_API_SOURCE_MAX_UPLOAD_BYTES=20971520
CORPUS_API_CHECK_ALLOWED_BASE_URLS=http://127.0.0.1:9100
CORPUS_TOOLROUTER_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CORPUS_TOOLROUTER_EMBEDDING_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
CORPUS_TOOLROUTER_EMBEDDING_DEVICE=cpu
CORPUS_TOOLROUTER_EMBEDDING_BATCH_SIZE=64
CORPUS_TOOLROUTER_EMBEDDING_LOCAL_FILES_ONLY=true
CORPUS_TOOLROUTER_MODEL_PROVIDER=ollama
CORPUS_TOOLROUTER_OLLAMA_URL=http://127.0.0.1:11434
CORPUS_TOOLROUTER_GENERATOR_MODEL=gemma4:latest
CORPUS_TOOLROUTER_REVIEWER_MODEL=qwen2.5-coder:7b
CORPUS_TOOLROUTER_OPENAI_REASONING_EFFORT=low
CORPUS_TOOLROUTER_EVALSET_TIMEOUT_SECONDS=240
CORPUS_DATABASE_URL=sqlite+aiosqlite:///D:/absolute/path/to/saastoagent-v0.1/.runtime/corpus.sqlite3
CORPUS_MIGRATION_REVISION=0019_builder_assembly_lifecycle
CORPUS_JOB_QUEUE_PATH=D:/absolute/path/to/saastoagent-v0.1/.runtime/corpus-jobs.sqlite3
CORPUS_CREDENTIAL_VAULT_KEY=<generated-url-safe-base64-encoded-32-byte-key>
CORPUS_RESET_SECRET=<generated-secret-at-least-32-bytes>
CORPUS_VERIFICATION_SECRET=<different-generated-secret-at-least-32-bytes>
CORPUS_AUTH_ACCESS_TOKEN_MINUTES=15
CORPUS_AUTH_IDLE_SESSION_DAYS=7
CORPUS_AUTH_ABSOLUTE_SESSION_DAYS=30
CORPUS_VERIFICATION_TOKEN_HOURS=24
CORPUS_RESET_TOKEN_HOURS=1
CORPUS_PUBLIC_FRONTEND_URL=http://127.0.0.1:5199
CORPUS_TRUSTED_PROXIES=127.0.0.1
CORPUS_SMTP_HOST=smtp.gmail.com
CORPUS_SMTP_PORT=587
CORPUS_SMTP_STARTTLS=true
CORPUS_SMTP_USERNAME=no-reply@saastoagent.com
CORPUS_SMTP_FROM_ADDRESS=no-reply@saastoagent.com
CORPUS_SMTP_APP_PASSWORD=<dedicated-gmail-app-password>
CORPUS_SMTP_TIMEOUT_SECONDS=5
