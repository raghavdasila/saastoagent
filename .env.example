STA_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/saastoagent_v0_1
STA_AUTH_SECRET=dev-secret-change-in-prod
STA_AUTH_TOKEN_LIFETIME_SECONDS=31536000
STA_CORS_ORIGINS=["http://localhost:3005"]

# Agent runtime (Slice 2)
STA_OPENAI_API_KEY=sk-your-key-here
STA_DEFAULT_MODEL=gpt-5-mini
STA_OPENAI_REASONING_EFFORT=minimal
STA_EMBEDDING_MODEL=text-embedding-3-small
STA_LANGSMITH_TRACING=false
STA_LANGSMITH_API_KEY=
STA_LANGSMITH_PROJECT=saastoagent v0.1
STA_UPLOAD_DIR=/app/uploads
STA_ANONYMOUS_CHAT_MESSAGES_PER_HOUR=10
STA_ANONYMOUS_CHAT_RATE_LIMIT_WINDOW_SECONDS=3600
